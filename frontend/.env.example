# Server-only backend API base URL. Include the version prefix.
API_URL=http://localhost:5000/api/v1

# Public canonical origin. This value is safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public feature flags. Keep aligned with backend settings.
NEXT_PUBLIC_COMMENTS_ENABLED=false

# Optional error monitoring DSN. Leave empty to disable the adapter.
NEXT_PUBLIC_SENTRY_DSN=

# Generate a strong random value of at least 32 characters.
REVALIDATE_SECRET=replace-with-a-long-random-secret-token

# Allowed clock skew for signed revalidation requests.
REVALIDATE_MAX_AGE_SECONDS=300
