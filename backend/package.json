{
  "name": "news-portal-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Production-ready Express API for the News Portal",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "lint": "eslint .",
    "typecheck": "node --check src/app.js && node --check src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run lint && npm run typecheck && npm test"
  },
  "engines": { "node": ">=22.0.0" },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
