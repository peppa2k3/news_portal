# Runtime
NODE_ENV=development
API_PORT=5000
APP_VERSION=2.0.0
LOG_LEVEL=info
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1

# PostgreSQL
DATABASE_URL=
POSTGRES_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10

# Redis (required in production; optional local fallback in development/tests)
REDIS_URL=redis://localhost:6379
CACHE_NAMESPACE=news-portal:v2

# Authentication - replace every secret with at least 32 random characters
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=

# Internal webhooks and preview
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
PREVIEW_SECRET=

# S3-compatible storage (MinIO locally)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=news-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/news-media
MAX_UPLOAD_MB=10

# Features and integrations
COMMENTS_ENABLED=true
MAIL_PROVIDER=console
SENTRY_DSN=
