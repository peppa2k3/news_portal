NODE_ENV=development
PORT=5000

# Recommended: one PostgreSQL connection URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/news_portal

# Set to true when the PostgreSQL provider requires TLS.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# These values are used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techreview
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
